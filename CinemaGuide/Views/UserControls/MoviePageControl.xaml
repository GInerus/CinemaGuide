<UserControl x:Class="CinemaGuide.Views.UserControls.MoviePageControl"
             xmlns:local="clr-namespace:CinemaGuide.Views.UserControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:helpers="clr-namespace:CinemaGuide.Helpers"
             xmlns:vm="clr-namespace:CinemaGuide.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="StyleButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                             Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Gray"/>
                    <Setter Property="Foreground" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Фон -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#001030" Offset="0"/>
                <GradientStop Color="#000000" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid>
            <Button HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="70" Height="60"
                Command="{Binding BackCommand}"
                Style="{DynamicResource StyleButton}"
                Cursor="Hand"
                Margin="10,10,0,0"
                Panel.ZIndex="10">
                <svg:SvgViewbox Source="Resource/arrowLeft.svg" Margin="6"/>
            </Button>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30">
                    <!-- Заголовок -->
                    <TextBlock Text="{Binding Title}"
                           FontSize="42"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,10,0,30"
                           TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Постер -->
                        <Border Grid.Column="0"
                        Width="200"
                        Height="300"
                        Background="#1A1A1A"
                        Margin="0,0,30,0"
                        VerticalAlignment="Top">

                            <Grid>
                                <Image x:Name="PosterImage"
                               Source="{Binding Poster}"
                               Stretch="UniformToFill"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True">

                                    <Image.Clip>
                                        <RectangleGeometry RadiusX="12" RadiusY="12"
                               Rect="0,0,200,300"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>

                        <!-- Правая часть -->
                        <StackPanel Grid.Column="1" Orientation="Vertical">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Блок информации -->
                                <Border Grid.Column="0"
                                Background="#0A0A25"
                                CornerRadius="12"
                                Padding="15"
                                Margin="0,0,10,20">
                                    <StackPanel>

                                        <TextBlock Text="Информация"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,10"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Text="Длительность: " Foreground="White" FontSize="16"/>
                                            <TextBlock Text="{Binding DurationFormatted}" Foreground="White" FontSize="16"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Text="Год: " Foreground="White" FontSize="16"/>
                                            <TextBlock Text="{Binding ReleaseYear}" Foreground="White" FontSize="16"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Text="Возраст: " Foreground="White" FontSize="16"/>
                                            <TextBlock Text="{Binding AgeRating}" Foreground="White" FontSize="16"/>
                                            <TextBlock Text="+" Foreground="White" FontSize="16"/>
                                        </StackPanel>

                                        <!-- Жанры -->
                                        <WrapPanel Margin="0,10,0,0">
                                            <ItemsControl ItemsSource="{Binding Genres}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#333"
                                CornerRadius="6"
                                Padding="6,3"
                                Margin="3">
                                                            <TextBlock Text="{Binding}"
                                       Foreground="White"
                                       FontSize="14"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </WrapPanel>

                                    </StackPanel>
                                </Border>

                                <!-- Блок рейтингов -->
                                <Border Grid.Column="1"
                                Background="#0A0A25"
                                CornerRadius="12"
                                Padding="15"
                                Margin="10,0,0,20">
                                    <StackPanel>

                                        <TextBlock Text="Рейтинги"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,10"/>

                                        <StackPanel>
                                            <StackPanel Margin="0,4">
                                                <TextBlock Text="IMDB:" Foreground="White" FontSize="16"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <local:StarRatingControl Rating="{Binding ImdbRating}"/>
                                                    <TextBlock Text="{Binding ImdbRating}" Foreground="White" FontSize="20"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel>
                                            <StackPanel Margin="0,4">
                                                <TextBlock Text="Кинопоиск:" Foreground="White" FontSize="16"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <local:StarRatingControl Rating="{Binding KinopoiskRating}"/>
                                                    <TextBlock Text="{Binding KinopoiskRating}" Foreground="White" FontSize="20"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Описание -->
                            <Border Background="#0A0A25"
                                CornerRadius="12"
                                Padding="15">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Описание"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding Description}"
                                           TextWrapping="Wrap"
                                           Foreground="White"
                                           FontSize="16"
                                           LineHeight="24"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
