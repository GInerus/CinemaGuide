<UserControl x:Class="CinemaGuide.Views.UserControls.MoviePageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CinemaGuide.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <!-- Фон -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Blue" Offset="1.7"/>
                <GradientStop Color="Black" Offset="0.6"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Название -->
                <TextBlock Text="{Binding Title}"
                               FontSize="35" FontWeight="Bold"
                               Foreground="White" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="30,0,0,0"/>
                
                <Grid Margin="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Постер -->
                        <ColumnDefinition Width="*" />
                        <!-- Остальная информация -->
                        <ColumnDefinition Width="*" />
                        <!-- Оценки -->
                    </Grid.ColumnDefinitions>

                    <!-- Постер -->
                    <Border Grid.Column="0"  Width="250" Height="350" ClipToBounds="True" 
                            Background="#222" CornerRadius="10" VerticalAlignment="Top"
                            Margin="0,30,0,0">
                        <Image Source="{Binding Poster}" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <!-- Правая часть: информация о фильме -->
                            <StackPanel Grid.Column="1" Margin="20,30,0,0" Background="#000025">

                                <!-- Информация -->
                                <StackPanel Orientation="Vertical" Margin="0,0,0,20">
                                    <TextBlock Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" Text="Информация"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Длительность: " Foreground="White" FontSize="16"/>
                                        <TextBlock Text="{Binding DurationFormatted}" Foreground="White" FontSize="16"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Год: " Foreground="White" FontSize="16"/>
                                        <TextBlock Text="{Binding ReleaseYear}" Foreground="White" FontSize="16"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Возраст: " Foreground="White" FontSize="16"/>
                                        <TextBlock Text="{Binding AgeRating}" Foreground="White" FontSize="16"/>
                                        <TextBlock Text="+" Foreground="White" FontSize="16"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Жанры -->
                                <ItemsControl ItemsSource="{Binding Genres}" Margin="0,0,0,20">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#333" CornerRadius="6" Padding="6" Margin="3">
                                                <TextBlock Text="{Binding}" Foreground="White" FontSize="14"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Оценки -->
                            <StackPanel Grid.Column="2" Margin="20,30,0,0" Background="#000025">

                                <TextBlock Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" Text="Рейтинг"/>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="IMDB: " Foreground="White" FontSize="16"/>
                                    <TextBlock Text="{Binding ImdbRating}" Foreground="White" FontSize="16"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Кинопоиск: " Foreground="White" FontSize="16"/>
                                    <TextBlock Text="{Binding KinopoiskRating}" Foreground="White" FontSize="16"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Описание -->
                        <TextBlock Text="{Binding Description}"
                            TextWrapping="Wrap"
                            Foreground="White"
                            FontSize="16"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
