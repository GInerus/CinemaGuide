<UserControl x:Class="CinemaGuide.Views.UserControls.AuthUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CinemaGuide.Views.UserControls"
             xmlns:vm="clr-namespace:CinemaGuide.ViewModels"
             xmlns:models="clr-namespace:CinemaGuide.Models"
             xmlns:converters="clr-namespace:CinemaGuide.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Конвертер -->
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <!-- DataTemplate для CircleItemViewModel (пользователи) -->
        <!-- DataTemplate для CircleItemViewModel -->
        <DataTemplate DataType="{x:Type vm:CircleItemViewModel}">
            <Grid Height="250">
                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Canvas Width="150" Height="150" Grid.Row="0">
                    <Ellipse Fill="{Binding BackgroundBrush}" Height="150" Width="150"/>
                </Canvas>

                <TextBlock Text="{Binding FirstCharacterOfLogin}" FontSize="60" Width="150"
                           Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                           TextAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                <TextBlock Text="{Binding Login}" FontSize="30" Canvas.Bottom="0" 
                           Width="150" TextAlignment="Center" Grid.Row="1"
                           Foreground="White" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

        <!-- DataTemplate для CreateAccountItem -->
        <DataTemplate DataType="{x:Type models:CreateAccountItem}">
            <Grid Height="250">
                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Canvas Width="150" Height="150" Grid.Row="0">
                    <Ellipse Fill="{Binding Color}" Height="150" Width="150"/>
                </Canvas>

                <TextBlock Text="{Binding FirstCharacterOfLogin}" FontSize="60" Width="150"
                           TextAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                <TextBlock Text="{Binding Login}" FontSize="30" Canvas.Bottom="0" 
                           Width="150" TextAlignment="Center" Grid.Row="1"
                           Foreground="White" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="70*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>

        <!-- Фон градиент -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Blue" Offset="1.7" />
                <GradientStop Color="Black" Offset="0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Заголовок -->
        <Viewbox Margin="0,0,0,10">
            <TextBlock Grid.Row="0"
                       Text="Выберите профиль" 
                       Foreground="White" 
                       FontSize="50" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,0"/>
        </Viewbox>

        <!-- Список пользователей и кнопка "Создать" -->
        <ListView Background="Transparent" Grid.Row="1"  
                  BorderBrush="Transparent" ScrollViewer.CanContentScroll="False"
                  ItemsSource="{Binding Circles}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="Blue"/>
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                        <Setter TargetName="Bd" Property="CornerRadius" Value="10"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#000087"/>
                                        <Setter TargetName="Bd" Property="CornerRadius" Value="10"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
