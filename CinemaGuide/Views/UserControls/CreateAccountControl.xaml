<UserControl x:Class="CinemaGuide.Views.UserControls.CreateAccountControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:converters="clr-namespace:CinemaGuide.Converters"
             xmlns:helpers="clr-namespace:CinemaGuide.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">



    <UserControl.Resources>
        <Style x:Key="StyleButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Gray"/>
                    <Setter Property="Foreground" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Blue" Offset="1.7"/>
                <GradientStop Color="Black" Offset="0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Width="60">
            <Button Width="100" Height="80"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource StyleButton}">
                <svg:SvgViewbox Source="Resource/arrowLeft.svg" Margin="4"/>
            </Button>
        </Viewbox>

        <Grid MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <!-- Круг с буквой или аватаром -->
            <Grid Grid.Column="0">
                <Viewbox Stretch="Uniform" Margin="30">
                    <Grid Width="50" Height="50">
                        <Ellipse Fill="{Binding BackgroundBrush}"/>
                        <Image Source="{Binding AvatarPath}" Stretch="UniformToFill" Visibility="{Binding AvatarVisibility}"/>
                        <TextBlock Text="{Binding FirstCharacter}" Foreground="Black" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Viewbox>
            </Grid>

            <Grid Grid.Column="1">
                <StackPanel Orientation="Vertical" Margin="10">
                    <TextBlock Text="Создать аккаунт" Foreground="White" FontSize="40" TextAlignment="Center" Margin="0,0,0,20"/>

                    <TextBox Width="300" FontSize="18"
                             helpers:TextBoxHelper.Watermark="Логин"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                    <PasswordBox x:Name="PasswordBox" Width="300" FontSize="18"
                                 Style="{DynamicResource RoundedPasswordBoxStyle}"
                                 helpers:PasswordBoxHelper.Watermark="Пароль"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <PasswordBox x:Name="ConfirmPasswordBox" Width="300" FontSize="18"
                                 Style="{DynamicResource RoundedPasswordBoxStyle}"
                                 helpers:PasswordBoxHelper.Watermark="Повторите пароль"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

                    <DatePicker SelectedDate="{Binding BirthDate}" Margin="0,5"/>
                    <Button Content="Выбрать аватар" Command="{Binding ChooseAvatarCommand}" Style="{StaticResource StyleButton}" Margin="0,5"/>
                    <Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}" Style="{StaticResource StyleButton}" Margin="0,10"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>