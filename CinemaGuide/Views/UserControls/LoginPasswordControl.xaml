<UserControl x:Class="CinemaGuide.Views.UserControls.LoginPasswordControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:CinemaGuide.Converters"
             xmlns:helpers="clr-namespace:CinemaGuide.Helpers" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Конвертер -->
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <!-- Стиль для кнопки с закругленными углами -->
        <Style x:Key="StyleButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" 
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Blue" Offset="1.7" />
                <GradientStop Color="Black" Offset="0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition  Width="3*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Command="{Binding BackCommand}" 
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="10" Style="{DynamicResource StyleButton}">
                
                <svg:SvgViewbox Source="resource/arrowLeft.svg"/>
            </Button>
            
            <Viewbox Grid.RowSpan="2"  Stretch="Uniform" Margin="30">
                <Ellipse  Fill="Transparent" Height="50" Width="50" 
                          Stroke="White" StrokeThickness="6"/>
            </Viewbox>
        </Grid>

        <Viewbox Grid.Column="1" Margin="50">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding LoginText}" Height="100" Foreground="White" 
                           FontSize="50" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Height="50">
                    <PasswordBox Width="300"/>
                    <Button Command="{Binding LoginCommand}" Margin="10,0,0,0"
                            Style="{DynamicResource StyleButton}">
                        <svg:SvgViewbox Source="resource/arrowRight.svg"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Viewbox>

    </Grid>
</UserControl>
