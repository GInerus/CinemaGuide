<UserControl x:Class="CinemaGuide.Views.UserControls.LoginPasswordControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:CinemaGuide.Helpers" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Blue" Offset="1.7" />
                <GradientStop Color="Black" Offset="0" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>

            <RowDefinition Height="3*"/>
            <!-- Аватарка -->
            <RowDefinition Height="1*"/>
            <!-- Имя пользователя -->
            <RowDefinition Height="1*"/>
            <!-- Надпись "Введите пароль" -->
            <RowDefinition Height="1*"/>
            <!-- Поле для ввода пароля и кнопка -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- 1. Аватарка -->
        <Border Grid.Row="1" Width="120" Height="120" CornerRadius="60" Background="Gray"
            HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="{Binding UserAvatar}" Stretch="UniformToFill"/>
        </Border>

        <!-- 2. Имя пользователя -->
        <TextBlock Grid.Row="2" Text="{Binding SelectedLogin}" 
                FontSize="24" FontWeight="Bold" Foreground="White"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- 3. Надпись "Введите пароль" -->
        <TextBlock Grid.Row="3" Text="Введите пароль:" 
                FontSize="18" Foreground="White"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- 4. Поле для ввода пароля и кнопка -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <PasswordBox Width="200" Margin="0,0,10,0"
                        helpers:PasswordBoxHelper.BindPassword="True"
                        helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Войти" Width="100" Command="{Binding LoginCommand}"/>
        </StackPanel>

    </Grid>
</UserControl>
