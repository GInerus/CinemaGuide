<UserControl x:Class="CinemaGuide.Views.UserControls.LoginPasswordControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:CinemaGuide.Converters"
             xmlns:helpers="clr-namespace:CinemaGuide.Helpers" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Конвертер -->
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <!-- Стиль для кнопки с закругленными углами -->
        <Style x:Key="StyleButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                        Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Gray"/>
                    <Setter Property="Foreground" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для PasswordBox с закругленными углами -->
        <Style x:Key="RoundedPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Blue" Offset="1.7" />
                <GradientStop Color="Black" Offset="0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" 
                 Width="60">
            <Button Width="100" Height="80"
            Command="{Binding BackCommand}"
            Style="{DynamicResource StyleButton}">
                <svg:SvgViewbox Source="resource/arrowLeft.svg" Margin="4"/>
            </Button>
        </Viewbox>


        <Grid MaxWidth="800">

            <Grid.ColumnDefinitions>
            <ColumnDefinition  Width="3*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>

            <Viewbox Grid.RowSpan="2" Stretch="Uniform" Margin="30">
                <Grid Width="50" Height="50">
                    <!-- Основной круг -->
                    <Ellipse Fill="{Binding BackgroundBrush}"/>

                    <!-- Буква по центру, будет видна только если картинки нет -->
                    <TextBlock Text="{Binding FirstCharacter}" 
               Foreground="Black"
               FontSize="24" 
               Margin="0,0,0,3"
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"/>
                </Grid>
            </Viewbox>
        </Grid>

        <Viewbox Grid.Column="1" Margin="50">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding LoginText}" Height="100" Foreground="White" 
                       FontSize="50" TextAlignment="Center" Margin="0,0,55,0"/>
                <StackPanel Orientation="Horizontal" Height="50">
                    <PasswordBox x:Name="PasswordBox" Width="300" FontSize="18"
                             Style="{DynamicResource RoundedPasswordBoxStyle}"/>
                    <Button Command="{Binding LoginCommand}" Margin="10,0,0,0"
                        CommandParameter="{Binding ElementName=PasswordBox}"
                        Style="{DynamicResource StyleButton}">
                        <svg:SvgViewbox Source="resource/arrowRight.svg" Margin="4"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Viewbox>
    </Grid>


    </Grid>
</UserControl>
