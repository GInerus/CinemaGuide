<UserControl x:Class="CinemaGuide.Views.UserControls.MoviesCatalogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CinemaGuide.ViewModels"
             xmlns:helpers="clr-namespace:CinemaGuide.Helpers">

    <UserControl.Resources>
        <helpers:ColumnCountConverter x:Key="ColumnCountConverter" MinItemWidth="160"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:MoviesCatalogViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Blue" Offset="1.7"/>
                <GradientStop Color="Black" Offset="0.6"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      helpers:ScrollLoadBehavior.LoadNextPageCommand="{Binding LoadNextPageCommand}">

            <ItemsControl ItemsSource="{Binding Movies}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ActualWidth, Converter={StaticResource ColumnCountConverter}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" Padding="10" Background="#000090" CornerRadius="8">
                            <Grid Width="Auto" Height="273">
                                <!-- Постер с скруглением через ImageBrush -->
                                <Border CornerRadius="8" Height="225" VerticalAlignment="Top" ClipToBounds="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding PosterPath}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>

                                <!-- Рейтинг поверх постера -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="#AA000000" CornerRadius="5" Margin="5" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="★" Foreground="Gold" FontSize="14" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding KinopoiskRating}" Foreground="White" FontSize="14"/>
                                    </StackPanel>
                                </Border>

                                <!-- Название фильма снизу -->
                                <TextBlock Text="{Binding Title}" 
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           Margin="0,230,0,0"
                                           VerticalAlignment="Center"
                                           MaxHeight="60"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
