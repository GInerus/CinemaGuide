<UserControl x:Class="CinemaGuide.Views.UserControls.MoviesCatalogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CinemaGuide.ViewModels"
             xmlns:helpers="clr-namespace:CinemaGuide.Helpers">

    <UserControl.DataContext>
        <vm:MoviesCatalogViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
              helpers:ScrollLoadBehavior.LoadNextPageCommand="{Binding LoadNextPageCommand}">
        <ItemsControl ItemsSource="{Binding Movies}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="10" Padding="10" 
                            Background="#1A1A1A" 
                            CornerRadius="8">
                        <StackPanel Width="150">
                            <Image Source="{Binding PosterPath}" 
                                   Height="220"
                                   Stretch="UniformToFill"
                                   Margin="0 0 0 10"/>

                            <TextBlock Text="{Binding Title}" 
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>
    </ScrollViewer>
</UserControl>
