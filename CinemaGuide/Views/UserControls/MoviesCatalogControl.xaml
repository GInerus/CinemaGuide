<UserControl x:Class="CinemaGuide.Views.UserControls.MoviesCatalogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CinemaGuide.ViewModels"
             xmlns:helpers="clr-namespace:CinemaGuide.Helpers"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:conv="clr-namespace:CinemaGuide.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <helpers:ColumnCountConverter x:Key="ColumnCountConverter" MinItemWidth="160"/>
        <!-- Встроенный конвертер для bool → Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>


        <Style x:Key="StyleButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="White"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Gray"/>
                    <Setter Property="Foreground" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:MoviesCatalogViewModel/>
    </UserControl.DataContext>

    <Grid>
        <!-- Фон -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Blue" Offset="1.7"/>
                <GradientStop Color="Black" Offset="0.6"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <!-- Верхняя панель -->
            <RowDefinition Height="*"/>
            <!-- Контент -->
        </Grid.RowDefinitions>


        <!--■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■-->
        <!--           ВЕРХНЯЯ ПАНЕЛЬ              -->
        <!--■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■-->

        <Grid Grid.Row="0" Margin="10" VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Назад -->
                <ColumnDefinition Width="*"/>
                <!-- Вкладки -->
                <ColumnDefinition Width="Auto"/>
                <!-- Мой профиль -->
            </Grid.ColumnDefinitions>

            <!-- Кнопка назад -->
            <Button Grid.Column="0"
                    Width="70" Height="60"
                    Command="{Binding BackCommand}"
                    Style="{DynamicResource StyleButton}"
                    Background="White"
                    BorderThickness="0"
                    Margin="0,0,10,0"
                    Cursor="Hand">
                <svg:SvgViewbox Source="Resource/arrowLeft.svg" Margin="6"/>
            </Button>

            <!-- Вкладки -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Кнопка Каталог (белый фон, черный текст) -->
                <Button Content="Каталог" Margin="0,0,10,0"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Catalog"
                        Width="200" Height="50"
                        Padding="20,8"
                        FontSize="22"
                        Cursor="Hand"
                        Background="White"
                        Foreground="Black">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="BorderBrush" Value="White"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Gray"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="DarkGray"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Кнопка Рекомендации (прозрачный фон, белый текст) -->
                <Button Content="Рекомендации" Margin="10,0,0,0"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Recommendations"
                        Width="200" Height="50"
                        Padding="20,8"
                        FontSize="22"
                        Cursor="Hand"
                        Background="Transparent"
                        Foreground="White">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="White"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="Gray"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="Black"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Кнопка Профиля -->
            <Button Grid.Column="2"
                    Width="70" Height="60"
                    Command="{Binding OpenProfileCommand}"
                    Style="{DynamicResource StyleButton}"
                    Background="White"
                    BorderThickness="0"
                    Margin="0,0,10,0"
                    Cursor="Hand">
                <svg:SvgViewbox Source="Resource/person.svg" Margin="6"/>
            </Button>


        </Grid>



        <!--■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■-->
        <!--         ПРОКРУЧИВАЕМЫЙ КАТАЛОГ        -->
        <!--■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■-->

        <ScrollViewer Grid.Row="1"
              Margin="10,5,10,10"
              VerticalScrollBarVisibility="Auto"
              CanContentScroll="False"
              helpers:ScrollLoadBehavior.LoadNextPageCommand="{Binding LoadNextPageCommand}">

            <ItemsControl ItemsSource="{Binding Movies}"
                  HorizontalContentAlignment="Stretch">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding
                        RelativeSource={RelativeSource AncestorType=ScrollViewer},
                        Path=ActualWidth,
                        Converter={StaticResource ColumnCountConverter}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>


                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Margin="5" Padding="10" Background="#000090" CornerRadius="8"
                        helpers:PosterLoaderBehavior.EnableLazyLoad="True"
                        Cursor="Hand">

                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.OpenMovieCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding MovieId}"/>
                            </Border.InputBindings>

                            <Grid Width="Auto" Height="273">
                                <!-- Постер -->
                                <Border CornerRadius="8" Height="225"
                                VerticalAlignment="Top" ClipToBounds="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding PosterImage}"
                                            Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>

                                <!-- Рейтинг -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
        Background="#AA000000" CornerRadius="5"
        Margin="5" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="★" Foreground="Gold" FontSize="14" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding KinopoiskRating}" Foreground="White" FontSize="14"/>
                                    </StackPanel>
                                </Border>

                                <!-- Название -->
                                <TextBlock Text="{Binding Title}"
                           Foreground="White"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Margin="0,230,0,0"
                           VerticalAlignment="Center"
                           MaxHeight="60"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Элементы поверх каталога -->
        <Grid Grid.Row="1" Panel.ZIndex="10">
            <!-- Элипс с кнопками поверх каталога -->
            <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Panel.ZIndex="10">
                <Border Width="100" Height="50" Background="White" CornerRadius="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Кнопка Поиск -->
                        <Button Width="35" Height="35" 
                                Command="{Binding ToggleSearchCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Margin="0,0,5,0"
                                Cursor="Hand">
                            <svg:SvgViewbox Source="Resource/magnifier.svg"/>
                        </Button>

                        <!-- Кнопка Фильтры -->
                        <Button Width="35" Height="35" 
                                Command="{Binding ToggleFiltersCommand}" 
                                Background="Transparent" 
                                BorderThickness="0"
                                Margin="5,0,0,0"
                                Cursor="Hand">
                            <svg:SvgViewbox Source="Resource/filters.svg"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Поле поиска снизу -->
            <Grid Margin="20,20,130,20" VerticalAlignment="Bottom" Height="40"
      Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBox x:Name="SearchBox"
             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
             Background="White"
             Foreground="Black"
             Padding="5"
             VerticalContentAlignment="Center"/>
                <TextBlock Text="Поиск фильма..."
                           Foreground="Gray"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding Text, 
                                        ElementName=SearchBox, 
                                        Converter={StaticResource 
                                        StringNullOrEmptyToVisibilityConverter}}"/>
            </Grid>

            <!-- Панель фильтров справа -->
            <Border Width="300" Background="#CC111111" Margin="0,0,0,80"
                    VerticalAlignment="Stretch" HorizontalAlignment="Right"
                    Visibility="{Binding IsFiltersVisible, 
                                Converter={StaticResource 
                                BoolToVisibilityConverter}}">
                <!-- Здесь размести свои фильтры -->
            </Border>
        </Grid>
    </Grid>

</UserControl>
