<UserControl x:Class="CinemaGuide.Views.UserControls.UserProfileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CinemaGuide.ViewModels"
             xmlns:helpers="clr-namespace:CinemaGuide.Helpers"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/">

    <UserControl.Resources>
        <!-- Стиль кнопки, можно использовать такой же как и в MoviesCatalogControl -->
        <Style x:Key="StyleButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                             Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Gray"/>
                    <Setter Property="Foreground" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Фон -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Blue" Offset="1.7"/>
                <GradientStop Color="Black" Offset="0.6"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <!-- Верхняя панель -->
            <RowDefinition Height="*"/>
            <!-- Контент -->
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Grid Grid.Row="0" Margin="10" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Кнопка назад -->
                <ColumnDefinition Width="*"/>
                <!-- Пустое место -->
            </Grid.ColumnDefinitions>

            <!-- Кнопка назад -->
            <Button Grid.Column="0"
                    Width="70" Height="60"
                    Command="{Binding BackCommand}"
                    Style="{DynamicResource StyleButton}"
                    Cursor="Hand"
                    Margin="0,0,10,0">
                <svg:SvgViewbox Source="Resource/arrowLeft.svg" Margin="6"/>
            </Button>
        </Grid>

        <!-- Контент пользователя -->
        <StackPanel Grid.Row="1"
                    Margin="20"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Orientation="Vertical">

            <!-- Никнейм -->
            <TextBlock Text="{Binding User.Username}"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       TextAlignment="Center"/>

            <!-- Год рождения -->
            <TextBlock Text="{Binding User.BirthDate}"
                       Foreground="White"
                       FontSize="22"
                       TextAlignment="Center"/>

        </StackPanel>
    </Grid>
</UserControl>
