<Page x:Class="CinemaGuide.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CinemaGuide"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="70*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Blue" Offset="1.7" />
                <GradientStop Color="Black" Offset="0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Viewbox Margin="0,0,0,10">
            <TextBlock Grid.Row="0"
                  Text="Выберите профиль" 
                  Foreground="White" 
                  FontSize="50" 
                  FontWeight="Bold" 
                  HorizontalAlignment="Center" 
                  Margin="0,10,0,0"/>
        </Viewbox>
        

        <ListView Background="Transparent" Grid.Row="1"  
                  BorderBrush="Transparent">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="250">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Canvas Width="150" Height="150" Grid.Row="0">
                            <Ellipse Fill="{Binding Color}" Height="150" Width="150"/>
                        </Canvas>
                        <TextBlock Text="{Binding FirstCharacterOfLogin}" FontSize="60"/>
                        <TextBlock Text="{Binding Login}" FontSize="30" Canvas.Bottom="0" 
               Width="150" TextAlignment="Center" Grid.Row="1"
               Foreground="White" TextWrapping="Wrap"/>
                    </Grid>
                    
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ItemsSource>
                <CompositeCollection>
                    <local:CircleItem Color="Red" Login="Роман"/>
                    <local:CircleItem Color="Black" Login="Александр"/>
                    <local:CircleItem Color="Purple" Login="Дмитрий"/>
                    <local:CircleItem Color="Pink" Login="Герман"/>
                    <local:CircleItem Color="WhiteSmoke" Login="Евгений"/>

                </CompositeCollection>
            </ListView.ItemsSource>
            
        </ListView>

    </Grid>
    
</Page>
